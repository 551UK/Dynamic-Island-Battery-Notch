<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><array>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>BATTERY OUTLINE</string><key>footerText</key><string>The overlay should remain visible across Lock Screen, Home Screen and foreground apps, without intercepting touches. Lines shrink at each reported 1% battery change.</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Enabled</string><key>key</key><string>enabled</string><key>default</key><true/><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Automatic battery colours</string><key>key</key><string>autoColor</string><key>default</key><true/><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>AUTO COLOUR THRESHOLDS</string><key>footerText</key><string>0–20% red (#FF453A), 21–60% yellow (#FFD60A), 61–100% green (#30D158). Charging does not override the colour.</string></dict>
<dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Manual hex colour</string><key>key</key><string>fixedColor</string><key>default</key><string>#30D158</string><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>placeholder</key><string>#30D158</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>POSITION AND SIZE</string><key>footerText</key><string>Adjust if the two outlines do not follow your physical iPhone 14 Pro Max Island. Defaults 126pt × 37.33pt, 11pt from top.</string></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Island width</string><key>key</key><string>width</string><key>default</key><real>126</real><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>min</key><real>110</real><key>max</key><real>150</real><key>showValue</key><true/></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Island height</string><key>key</key><string>height</string><key>default</key><real>37.33</real><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>min</key><real>30</real><key>max</key><real>50</real><key>showValue</key><true/></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Top offset</string><key>key</key><string>offsetY</string><key>default</key><real>11</real><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>min</key><real>0</real><key>max</key><real>30</real><key>showValue</key><true/></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Line thickness</string><key>key</key><string>thickness</string><key>default</key><real>2.5</real><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>min</key><real>0.5</real><key>max</key><real>8</real><key>showValue</key><true/></dict>
