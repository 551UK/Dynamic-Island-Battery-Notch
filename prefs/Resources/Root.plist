<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><array>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>BATTERY OUTLINE</string><key>footerText</key><string>The overlay should remain visible across Lock Screen, Home Screen and foreground apps, without intercepting touches. Lines shrink at each reported 1% battery change.</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Enabled</string><key>key</key><string>enabled</string><key>default</key><true/><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Automatic battery colours</string><key>key</key><string>autoColor</string><key>default</key><true/><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>AUTO COLOUR THRESHOLDS</string><key>footerText</key><string>0–20% red (#FF453A), 21–60% yellow (#FFD60A), 61–100% green (#30D158). Charging uses the separately selected charging colour.</string></dict>
<dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Manual hex colour</string><key>key</key><string>fixedColor</string><key>default</key><string>#30D158</string><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>placeholder</key><string>#30D158</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>LINE THICKNESS</string><key>footerText</key><string>The lowest thickness is 1.5 pt; drag right to increase it. Position and shape are fixed.</string></dict>
<dict><key>cell</key><string>PSSliderCell</string><key>label</key><string>Line Thickness</string><key>key</key><string>thickness</string><key>default</key><real>2.5</real><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>min</key><real>1.5</real><key>max</key><real>8</real><key>showValue</key><true/></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>CHARGING COLOUR</string><key>footerText</key><string>Manual charging colour overrides the normal colour while plugged in.</string></dict>
<dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Charging Colour</string><key>key</key><string>chargingColor</string><key>default</key><string>#00D7FF</string><key>get</key><string>readPreferenceValue:</string><key>set</key><string>setPreferenceValue:specifier:</string><key>placeholder</key><string>#00D7FF</string></dict>
